# Host interface to publish on. 127.0.0.1 = this machine only (default, safest).
# Set to 0.0.0.0 to allow other LAN devices. The API has NO login, so anyone
# who can reach the port can read and overwrite your portfolio.
APP_BIND=127.0.0.1
APP_PORT=3001
# Browser origins allowed by CORS (comma-separated). Accepts exact origins
# (e.g. http://myhost.local:3001), "private" = any private-network origin
# (localhost, *.local, 192.168.x.x, 10.x, 172.16-31.x), or "*" = any website
# (not recommended: any page open in your browser could then read your data).
ALLOWED_ORIGIN=http://localhost:3001
